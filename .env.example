# Copy to .env and `chmod 600 .env` (the poller refuses a group/world-readable .env).
# Process environment variables override this file. Lists are comma-separated.

# --- Required --------------------------------------------------------------
SENDER_EMAIL=you@example.com
# Gmail App Password (spaces are fine)
SENDER_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# The ntfy topic name is the credential: make it long and random.
NTFY_TOPIC=change-me-to-a-long-random-topic

# --- Optional secrets --------------------------------------------------------
# NTFY_OPS_TOPIC=          # ops/admin notices; defaults to NTFY_TOPIC
# NTFY_TOKEN=              # ntfy access token, if the server needs one
# HEALTHCHECKS_PING_URL=https://hc-ping.com/<uuid>   # unset = no pings

# --- Optional settings (defaults shown) --------------------------------------
# EVENT_ID=2000655CAB442FB5
# EVENT_URL=https://www.ticketmaster.com/noah-kahan-the-last-of-the-birmingham-alabama-04-27-2027/event/2000655CAB442FB5
# EVENT_NAME=Noah Kahan — Protective Stadium, Birmingham AL
# EVENT_DATE=2027-04-27
# TIMEZONE=America/Chicago
# STOP_AFTER=2027-04-28T00:00:00          # interpreted in TIMEZONE

# POLL_INTERVAL_SECONDS=300
# POLL_JITTER_SECONDS=60
# ERROR_BACKOFF_MAX_SECONDS=1800
# BLOCK_BACKOFF_BASE_SECONDS=900
# BLOCK_BACKOFF_MAX_SECONDS=3600
# FAILURE_ALERT_AFTER_MINUTES=60

# WANTED_QUANTITIES=2,3                   # exact purchase sizes that can alert (2 and/or 3)
# PREFERRED_QUANTITIES=3                  # subset of WANTED_QUANTITIES
# PRIMARY_ALERT_MAX_PRICE=200.00          # $/ticket listPrice (excl. fees)
# PREFERRED_MAX_PRICE=300.00              # $/ticket for a preferred quantity
# PRIMARY_DROP_PERCENT=20                 # vs the 7-day median
# BASELINE_WINDOW_DAYS=7
# BASELINE_MIN_SAMPLES=12
# REALERT_AFTER_ABSENT_HOURS=24           # 0 disables re-arm
# CANARY_HOUR=8

# CHROMIUM_PATH=/usr/bin/chromium
# BROWSER_PROFILE_DIR=~/.local/share/em_ticket_scrape/chromium-profile
# BROWSER_PROFILE_ROTATE_ON_BLOCK=true    # set the profile aside when Ticketmaster blocks it
# BROWSER_PROFILE_KEEP_FLAGGED=2          # set-aside profiles kept for inspection
# BROWSER_EXTRA_ARGS=--ozone-platform=x11
# BROWSER_RECYCLE_HOURS=6
# CAPTURE_TIMEOUT_SECONDS=20
# CAPTURE_SETTLE_SECONDS=3
# STATE_DIR=~/.local/share/em_ticket_scrape

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TIMEOUT_SECONDS=20
# ALERT_RECIPIENTS=philip@ferreira-family.com
# ADMIN_EMAIL=philip@ferreira-family.com
# NTFY_SERVER=https://ntfy.sh
# LOG_LEVEL=INFO
# WATCHDOG_TIMEOUT_SEC=900                # one poll/notice step hung longer exits for a restart
