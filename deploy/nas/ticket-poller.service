# systemd user unit for the Ticketmaster poller on the UGREEN NAS (headless box, Xvfb).
# Derived from deploy/ticket-poller.service. Installed by deploy/nas/install.sh into
# ~/.config/systemd/user/; that script rewrites the repo paths below if the checkout is
# not at ~/repos/em_ticket_scrape. Needs `loginctl enable-linger` to run without a login.

[Unit]
Description=Ticketmaster poller (Noah Kahan, 2027-04-27), NAS
Documentation=file://%h/repos/em_ticket_scrape/README.md
# Headed Chromium draws on the Xvfb display. Wants= + After= only, so Xvfb's state never
# stops or fails this unit:
# - Requires= would leave it inactive after a failed Xvfb start (job result "dependency",
#   no OnFailure=), and Xvfb's later auto-restart only try-restarts it: no effect.
# - PartOf= would restart it on every failed Xvfb retry, so a long Xvfb outage runs it into
#   StartLimitBurst and leaves it failed, which the later try-restart doesn't undo either.
# Instead the poller rides out an Xvfb outage itself: with no display the browser launch
# (or the running browser) fails, the poll is recorded as failed (backoff, admin alert),
# the browser is closed and is relaunched by the next poll once Xvfb is back (reading
# Xvfb's new auth cookie). Stopping Xvfb no longer stops the poller: stop both explicitly.
Wants=ticket-poller-xvfb.service
After=ticket-poller-xvfb.service
StartLimitIntervalSec=1h
StartLimitBurst=20
# When the unit really fails (exit 78, or the start limit is hit), push an ops alert.
# Ordinary auto-restarts don't trigger it (see Restart= below).
OnFailure=ticket-poller-failure.service

[Service]
Type=exec
WorkingDirectory=%h/repos/em_ticket_scrape
# The app reads ./.env itself (with its owner/0600 check), so no EnvironmentFile=. On the
# NAS, .env must set CHROMIUM_PATH, STATE_DIR and BROWSER_PROFILE_DIR (see README).
# No systemd-inhibit (Access denied on UGOS; a NAS doesn't suspend) and so no ExecStop
# helper: the poller is the main process and gets systemd's SIGTERM itself.
ExecStart=%h/repos/em_ticket_scrape/.venv/bin/ticket-poller run
# After a stop, SIGKILL anything left in the cgroup (e.g. an orphaned Chromium).
KillMode=mixed
TimeoutStopSec=45
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:99
Environment=XAUTHORITY=%h/repos/em_ticket_scrape/.nas/xauthority
# The real $HOME and /tmp are world-writable on UGOS, and Chromium writes its NSS database
# (~/.local/share/pki) and Playwright its temp dirs there, so point both into the 0700
# project. (.env paths must therefore be absolute, not ~/…). UGOS's /etc/pulse/client.conf
# sets cookie-file = /tmp/.config/pulse-cookie, which Chromium's audio code would create in
# the shared /tmp; PULSE_COOKIE overrides it. deploy/nas/run.sh sets the same.
Environment=HOME=%h/repos/em_ticket_scrape/.nas/home
Environment=TMPDIR=%h/repos/em_ticket_scrape/.nas/tmp
Environment=PULSE_COOKIE=%h/repos/em_ticket_scrape/.nas/home/pulse-cookie
UMask=0077
# $HOME and ~/repos are 0777 on UGOS: warn loudly in the journal if they (or the dirs down to
# the project and unit dirs) are writable by others again, e.g. after a UGOS update. Only a
# warning ("-"): a failing check would make the poller crash-loop.
ExecStartPre=-%h/repos/em_ticket_scrape/deploy/nas/check-perms.sh --journal %h %h/repos/em_ticket_scrape %h/.config/systemd/user

# Exit codes: 0 = event over / signal (no restart), 1 = crash or watchdog (restart),
# 75 = instance lock held (restart after RestartSec), 78 = bad config, .env perms or an
# unreadable/corrupt state database (no restart: it would fail the same way).
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=78
# No RestartMode=direct: UGOS has systemd 252, which doesn't know it (v254+) and fails the
# verify in install.sh. 252 already behaves like "direct": auto-restarts skip the failed
# state, so OnFailure= fires only on a real failure (tested on the NAS).

# stdout/stderr go to the journal: journalctl --user -u ticket-poller
SyslogIdentifier=ticket-poller

# Background job: yield CPU/IO to UGOS and its services.
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
# Chromium peaks at ≈1.1 GB PSS on the event page; the box has 7.5 GiB shared with UGOS.
# The memory controller is delegated to the user manager on the NAS, so these take effect.
MemoryHigh=1.5G
MemoryMax=2.5G

# Hardening that Chromium tolerates (verified with the live tests in a transient unit).
# Deliberately NOT set: MemoryDenyWriteExecute (V8 JIT), RestrictNamespaces (Chromium's
# user-namespace sandbox), PrivateTmp (hides /tmp/.X11-unix), PrivateDevices,
# ProtectHome/ProtectSystem/PrivateUsers (profile, state and repo live in $HOME).
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
