# systemd user unit: pushes "service FAILED" to the ntfy ops topic (design §16).
# Started by OnFailure= in ticket-poller.service; installed by deploy/install.sh (and, as is,
# by deploy/nas/install.sh on the NAS), which rewrite the repo paths below if the checkout
# is not at ~/repos/em_ticket_scrape.
# Best effort: it reads only the ntfy settings (NTFY_SERVER, NTFY_OPS_TOPIC or NTFY_TOPIC,
# NTFY_TOKEN) from the environment and .env, without validating the rest, and needs no state
# database or email. So it still pushes when the service exited 78 on invalid config, unsafe
# .env permissions (the push says so, without any secret) or a corrupt database. It exits 0
# only if the push was delivered.

[Unit]
Description=Ticketmaster poller failure push
Documentation=file://%h/repos/em_ticket_scrape/README.md

[Service]
Type=oneshot
WorkingDirectory=%h/repos/em_ticket_scrape
ExecStart=%h/repos/em_ticket_scrape/.venv/bin/ticket-poller notify-failure ticket-poller.service
TimeoutStartSec=2min
Environment=PYTHONUNBUFFERED=1
UMask=0077
SyslogIdentifier=ticket-poller-failure
NoNewPrivileges=yes
